{"n":81,"ayahs":[{"v":1,"ar":"إِذَا ٱلشَّمۡسُ كُوِّرَتۡ"},{"v":2,"ar":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ"},{"v":3,"ar":"وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ"},{"v":4,"ar":"وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ"},{"v":5,"ar":"وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ"},{"v":6,"ar":"وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ"},{"v":7,"ar":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ"},{"v":8,"ar":"وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ"},{"v":9,"ar":"بِأَيِّ ذَنۢبࣲ قُتِلَتۡ"},{"v":10,"ar":"وَإِذَا ٱلصُّحُفُ نُشِرَتۡ"},{"v":11,"ar":"وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ"},{"v":12,"ar":"وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ"},{"v":13,"ar":"وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ"},{"v":14,"ar":"عَلِمَتۡ نَفۡسࣱ مَّآ أَحۡضَرَتۡ"},{"v":15,"ar":"فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ"},{"v":16,"ar":"ٱلۡجَوَارِ ٱلۡكُنَّسِ"},{"v":17,"ar":"وَٱلَّيۡلِ إِذَا عَسۡعَسَ"},{"v":18,"ar":"وَٱلصُّبۡحِ إِذَا تَنَفَّسَ"},{"v":19,"ar":"إِنَّهُۥ لَقَوۡلُ رَسُولࣲ كَرِيمࣲ‏"},{"v":20,"ar":"ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينࣲ‏"},{"v":21,"ar":"مُّطَاعࣲ ثَمَّ أَمِينࣲ‏"},{"v":22,"ar":"وَمَا صَاحِبُكُم بِمَجۡنُونࣲ‏"},{"v":23,"ar":"وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ"},{"v":24,"ar":"وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينࣲ‏"},{"v":25,"ar":"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنࣲ رَّجِيمࣲ‏"},{"v":26,"ar":"فَأَيۡنَ تَذۡهَبُونَ"},{"v":27,"ar":"إِنۡ هُوَ إِلَّا ذِكۡرࣱ لِّلۡعَٰلَمِينَ"},{"v":28,"ar":"لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ"},{"v":29,"ar":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ"}]}