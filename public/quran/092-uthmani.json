{"n":92,"ayahs":[{"v":1,"ar":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰ"},{"v":2,"ar":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ"},{"v":3,"ar":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ"},{"v":4,"ar":"إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ"},{"v":5,"ar":"فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ"},{"v":6,"ar":"وَصَدَّقَ بِٱلۡحُسۡنَىٰ"},{"v":7,"ar":"فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ"},{"v":8,"ar":"وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ"},{"v":9,"ar":"وَكَذَّبَ بِٱلۡحُسۡنَىٰ"},{"v":10,"ar":"فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ"},{"v":11,"ar":"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ"},{"v":12,"ar":"إِنَّ عَلَيۡنَا لَلۡهُدَىٰ"},{"v":13,"ar":"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ"},{"v":14,"ar":"فَأَنذَرۡتُكُمۡ نَارࣰ ا تَلَظَّىٰ"},{"v":15,"ar":"لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى"},{"v":16,"ar":"ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ"},{"v":17,"ar":"وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى"},{"v":18,"ar":"ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ"},{"v":19,"ar":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةࣲ تُجۡزَىٰٓ"},{"v":20,"ar":"إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ"},{"v":21,"ar":"وَلَسَوۡفَ يَرۡضَىٰ"}]}