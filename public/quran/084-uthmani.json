{"n":84,"ayahs":[{"v":1,"ar":"إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ"},{"v":2,"ar":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ"},{"v":3,"ar":"وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ"},{"v":4,"ar":"وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ"},{"v":5,"ar":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ"},{"v":6,"ar":"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحࣰ ا فَمُلَٰقِيهِ"},{"v":7,"ar":"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ"},{"v":8,"ar":"فَسَوۡفَ يُحَاسَبُ حِسَابࣰ ا يَسِيرࣰ ا"},{"v":9,"ar":"وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورࣰ ا"},{"v":10,"ar":"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ"},{"v":11,"ar":"فَسَوۡفَ يَدۡعُواْ ثُبُورࣰ ا"},{"v":12,"ar":"وَيَصۡلَىٰ سَعِيرًا"},{"v":13,"ar":"إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا"},{"v":14,"ar":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ"},{"v":15,"ar":"بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرࣰ ا"},{"v":16,"ar":"فَلَآ أُقۡسِمُ بِٱلشَّفَقِ"},{"v":17,"ar":"وَٱلَّيۡلِ وَمَا وَسَقَ"},{"v":18,"ar":"وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ"},{"v":19,"ar":"لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقࣲ‏"},{"v":20,"ar":"فَمَا لَهُمۡ لَا يُؤۡمِنُونَ"},{"v":21,"ar":"وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩"},{"v":22,"ar":"بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ"},{"v":23,"ar":"وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ"},{"v":24,"ar":"فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ"},{"v":25,"ar":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۭ"}]}