{"n":107,"ayahs":[{"v":1,"ar":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ"},{"v":2,"ar":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ"},{"v":3,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ"},{"v":4,"ar":"فَوَيۡلࣱ لِّلۡمُصَلِّينَ"},{"v":5,"ar":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ"},{"v":6,"ar":"ٱلَّذِينَ هُمۡ يُرَآءُونَ"},{"v":7,"ar":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ"}]}