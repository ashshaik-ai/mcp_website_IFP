{"n":87,"ayahs":[{"v":1,"ar":"سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى"},{"v":2,"ar":"ٱلَّذِي خَلَقَ فَسَوَّىٰ"},{"v":3,"ar":"وَٱلَّذِي قَدَّرَ فَهَدَىٰ"},{"v":4,"ar":"وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ"},{"v":5,"ar":"فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ"},{"v":6,"ar":"سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ"},{"v":7,"ar":"إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ"},{"v":8,"ar":"وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ"},{"v":9,"ar":"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ"},{"v":10,"ar":"سَيَذَّكَّرُ مَن يَخۡشَىٰ"},{"v":11,"ar":"وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى"},{"v":12,"ar":"ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ"},{"v":13,"ar":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ"},{"v":14,"ar":"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ"},{"v":15,"ar":"وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ"},{"v":16,"ar":"بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا"},{"v":17,"ar":"وَٱلۡأٓخِرَةُ خَيۡرࣱ وَأَبۡقَىٰٓ"},{"v":18,"ar":"إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ"},{"v":19,"ar":"صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ"}]}