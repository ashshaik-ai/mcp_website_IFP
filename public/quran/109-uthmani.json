{"n":109,"ayahs":[{"v":1,"ar":"قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ"},{"v":2,"ar":"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ"},{"v":3,"ar":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ"},{"v":4,"ar":"وَلَآ أَنَا۠ عَابِدࣱ مَّا عَبَدتُّمۡ"},{"v":5,"ar":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ"},{"v":6,"ar":"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ"}]}