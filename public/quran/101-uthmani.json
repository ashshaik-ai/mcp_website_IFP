{"n":101,"ayahs":[{"v":1,"ar":"ٱلۡقَارِعَةُ"},{"v":2,"ar":"مَا ٱلۡقَارِعَةُ"},{"v":3,"ar":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ"},{"v":4,"ar":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ"},{"v":5,"ar":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ"},{"v":6,"ar":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ"},{"v":7,"ar":"فَهُوَ فِي عِيشَةࣲ رَّاضِيَةࣲ‏"},{"v":8,"ar":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ"},{"v":9,"ar":"فَأُمُّهُۥ هَاوِيَةࣱ‏"},{"v":10,"ar":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ"},{"v":11,"ar":"نَارٌ حَامِيَةُۢ"}]}