{"n":75,"ayahs":[{"v":1,"ar":"لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ"},{"v":2,"ar":"وَلَآ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ"},{"v":3,"ar":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ"},{"v":4,"ar":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ"},{"v":5,"ar":"بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ"},{"v":6,"ar":"يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ"},{"v":7,"ar":"فَإِذَا بَرِقَ ٱلۡبَصَرُ"},{"v":8,"ar":"وَخَسَفَ ٱلۡقَمَرُ"},{"v":9,"ar":"وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ"},{"v":10,"ar":"يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ"},{"v":11,"ar":"كَلَّا لَا وَزَرَ"},{"v":12,"ar":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ"},{"v":13,"ar":"يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ"},{"v":14,"ar":"بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةࣱ‏"},{"v":15,"ar":"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ"},{"v":16,"ar":"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ"},{"v":17,"ar":"إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ"},{"v":18,"ar":"فَإِذَا قَرَأۡنَٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ"},{"v":19,"ar":"ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ"},{"v":20,"ar":"كَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ"},{"v":21,"ar":"وَتَذَرُونَ ٱلۡأٓخِرَةَ"},{"v":22,"ar":"وُجُوهࣱ يَوۡمَئِذࣲ نَّاضِرَةٌ"},{"v":23,"ar":"إِلَىٰ رَبِّهَا نَاظِرَةࣱ‏"},{"v":24,"ar":"وَوُجُوهࣱ يَوۡمَئِذِۭ بَاسِرَةࣱ‏"},{"v":25,"ar":"تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةࣱ‏"},{"v":26,"ar":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِيَ"},{"v":27,"ar":"وَقِيلَ مَنۡۜ رَاقࣲ‏"},{"v":28,"ar":"وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ"},{"v":29,"ar":"وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ"},{"v":30,"ar":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ"},{"v":31,"ar":"فَلَا صَدَّقَ وَلَا صَلَّىٰ"},{"v":32,"ar":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ"},{"v":33,"ar":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهۡلِهِۦ يَتَمَطَّىٰٓ"},{"v":34,"ar":"أَوۡلَىٰ لَكَ فَأَوۡلَىٰ"},{"v":35,"ar":"ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰٓ"},{"v":36,"ar":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى"},{"v":37,"ar":"أَلَمۡ يَكُ نُطۡفَةࣰ مِّن مَّنِيࣲّ يُمۡنَىٰ"},{"v":38,"ar":"ثُمَّ كَانَ عَلَقَةࣰ فَخَلَقَ فَسَوَّىٰ"},{"v":39,"ar":"فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ"},{"v":40,"ar":"أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ"}]}