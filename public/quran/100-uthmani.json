{"n":100,"ayahs":[{"v":1,"ar":"وَٱلۡعَٰدِيَٰتِ ضَبۡحࣰ ا"},{"v":2,"ar":"فَٱلۡمُورِيَٰتِ قَدۡحࣰ ا"},{"v":3,"ar":"فَٱلۡمُغِيرَٰتِ صُبۡحࣰ ا"},{"v":4,"ar":"فَأَثَرۡنَ بِهِۦ نَقۡعࣰ ا"},{"v":5,"ar":"فَوَسَطۡنَ بِهِۦ جَمۡعًا"},{"v":6,"ar":"إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودࣱ‏"},{"v":7,"ar":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدࣱ‏"},{"v":8,"ar":"وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ"},{"v":9,"ar":"۞أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ"},{"v":10,"ar":"وَحُصِّلَ مَا فِي ٱلصُّدُورِ"},{"v":11,"ar":"إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذࣲ لَّخَبِيرُۢ"}]}