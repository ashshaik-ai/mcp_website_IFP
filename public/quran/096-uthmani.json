{"n":96,"ayahs":[{"v":1,"ar":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ"},{"v":2,"ar":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ"},{"v":3,"ar":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ"},{"v":4,"ar":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ"},{"v":5,"ar":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ"},{"v":6,"ar":"كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ"},{"v":7,"ar":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ"},{"v":8,"ar":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ"},{"v":9,"ar":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ"},{"v":10,"ar":"عَبۡدًا إِذَا صَلَّىٰٓ"},{"v":11,"ar":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ"},{"v":12,"ar":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ"},{"v":13,"ar":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ"},{"v":14,"ar":"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ"},{"v":15,"ar":"كَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ"},{"v":16,"ar":"نَاصِيَةࣲ كَٰذِبَةٍ خَاطِئَةࣲ‏"},{"v":17,"ar":"فَلۡيَدۡعُ نَادِيَهُۥ"},{"v":18,"ar":"سَنَدۡعُ ٱلزَّبَانِيَةَ"},{"v":19,"ar":"كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩"}]}