{"n":102,"ayahs":[{"v":1,"ar":"أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ"},{"v":2,"ar":"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ"},{"v":3,"ar":"كَلَّا سَوۡفَ تَعۡلَمُونَ"},{"v":4,"ar":"ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ"},{"v":5,"ar":"كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ"},{"v":6,"ar":"لَتَرَوُنَّ ٱلۡجَحِيمَ"},{"v":7,"ar":"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ"},{"v":8,"ar":"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ"}]}