{"n":90,"ayahs":[{"v":1,"ar":"لَآ أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ"},{"v":2,"ar":"وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ"},{"v":3,"ar":"وَوَالِدࣲ وَمَا وَلَدَ"},{"v":4,"ar":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ"},{"v":5,"ar":"أَيَحۡسَبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدࣱ‏"},{"v":6,"ar":"يَقُولُ أَهۡلَكۡتُ مَالࣰ ا لُّبَدًا"},{"v":7,"ar":"أَيَحۡسَبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ"},{"v":8,"ar":"أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ"},{"v":9,"ar":"وَلِسَانࣰ ا وَشَفَتَيۡنِ"},{"v":10,"ar":"وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ"},{"v":11,"ar":"فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ"},{"v":12,"ar":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ"},{"v":13,"ar":"فَكُّ رَقَبَةٍ"},{"v":14,"ar":"أَوۡ إِطۡعَٰمࣱ فِي يَوۡمࣲ ذِي مَسۡغَبَةࣲ‏"},{"v":15,"ar":"يَتِيمࣰ ا ذَا مَقۡرَبَةٍ"},{"v":16,"ar":"أَوۡ مِسۡكِينࣰ ا ذَا مَتۡرَبَةࣲ‏"},{"v":17,"ar":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ وَتَوَاصَوۡاْ بِٱلۡمَرۡحَمَةِ"},{"v":18,"ar":"أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ"},{"v":19,"ar":"وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ"},{"v":20,"ar":"عَلَيۡهِمۡ نَارࣱ مُّؤۡصَدَةُۢ"}]}