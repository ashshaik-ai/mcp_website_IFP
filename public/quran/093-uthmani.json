{"n":93,"ayahs":[{"v":1,"ar":"وَٱلضُّحَىٰ"},{"v":2,"ar":"وَٱلَّيۡلِ إِذَا سَجَىٰ"},{"v":3,"ar":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"},{"v":4,"ar":"وَلَلۡأٓخِرَةُ خَيۡرࣱ لَّكَ مِنَ ٱلۡأُولَىٰ"},{"v":5,"ar":"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ"},{"v":6,"ar":"أَلَمۡ يَجِدۡكَ يَتِيمࣰ ا فَـَٔاوَىٰ"},{"v":7,"ar":"وَوَجَدَكَ ضَآلࣰّ ا فَهَدَىٰ"},{"v":8,"ar":"وَوَجَدَكَ عَآئِلࣰ ا فَأَغۡنَىٰ"},{"v":9,"ar":"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ"},{"v":10,"ar":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ"},{"v":11,"ar":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ"}]}