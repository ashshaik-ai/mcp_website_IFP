{"n":94,"ayahs":[{"v":1,"ar":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ"},{"v":2,"ar":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ"},{"v":3,"ar":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ"},{"v":4,"ar":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ"},{"v":5,"ar":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا"},{"v":6,"ar":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرࣰ ا"},{"v":7,"ar":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ"},{"v":8,"ar":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب"}]}