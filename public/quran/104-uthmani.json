{"n":104,"ayahs":[{"v":1,"ar":"وَيۡلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ"},{"v":2,"ar":"ٱلَّذِي جَمَعَ مَالࣰ ا وَعَدَّدَهُۥ"},{"v":3,"ar":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ"},{"v":4,"ar":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ"},{"v":5,"ar":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ"},{"v":6,"ar":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ"},{"v":7,"ar":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ"},{"v":8,"ar":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةࣱ‏"},{"v":9,"ar":"فِي عَمَدࣲ مُّمَدَّدَةِۭ"}]}