{"n":86,"ayahs":[{"v":1,"ar":"وَٱلسَّمَآءِ وَٱلطَّارِقِ"},{"v":2,"ar":"وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ"},{"v":3,"ar":"ٱلنَّجۡمُ ٱلثَّاقِبُ"},{"v":4,"ar":"إِن كُلُّ نَفۡسࣲ لَّمَّا عَلَيۡهَا حَافِظࣱ‏"},{"v":5,"ar":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ"},{"v":6,"ar":"خُلِقَ مِن مَّآءࣲ دَافِقࣲ‏"},{"v":7,"ar":"يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ"},{"v":8,"ar":"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرࣱ‏"},{"v":9,"ar":"يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ"},{"v":10,"ar":"فَمَا لَهُۥ مِن قُوَّةࣲ وَلَا نَاصِرࣲ‏"},{"v":11,"ar":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ"},{"v":12,"ar":"وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ"},{"v":13,"ar":"إِنَّهُۥ لَقَوۡلࣱ فَصۡلࣱ‏"},{"v":14,"ar":"وَمَا هُوَ بِٱلۡهَزۡلِ"},{"v":15,"ar":"إِنَّهُمۡ يَكِيدُونَ كَيۡدࣰ ا"},{"v":16,"ar":"وَأَكِيدُ كَيۡدࣰ ا"},{"v":17,"ar":"فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا"}]}