{"n":82,"ayahs":[{"v":1,"ar":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ"},{"v":2,"ar":"وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ"},{"v":3,"ar":"وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ"},{"v":4,"ar":"وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ"},{"v":5,"ar":"عَلِمَتۡ نَفۡسࣱ مَّا قَدَّمَتۡ وَأَخَّرَتۡ"},{"v":6,"ar":"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ"},{"v":7,"ar":"ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ"},{"v":8,"ar":"فِيٓ أَيِّ صُورَةࣲ مَّا شَآءَ رَكَّبَكَ"},{"v":9,"ar":"كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ"},{"v":10,"ar":"وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ"},{"v":11,"ar":"كِرَامࣰ ا كَٰتِبِينَ"},{"v":12,"ar":"يَعۡلَمُونَ مَا تَفۡعَلُونَ"},{"v":13,"ar":"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمࣲ‏"},{"v":14,"ar":"وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمࣲ‏"},{"v":15,"ar":"يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ"},{"v":16,"ar":"وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ"},{"v":17,"ar":"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ"},{"v":18,"ar":"ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ"},{"v":19,"ar":"يَوۡمَ لَا تَمۡلِكُ نَفۡسࣱ لِّنَفۡسࣲ شَيۡـࣰٔ اۖ وَٱلۡأَمۡرُ يَوۡمَئِذࣲ لِّلَّهِ"}]}