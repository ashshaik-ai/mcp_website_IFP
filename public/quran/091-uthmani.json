{"n":91,"ayahs":[{"v":1,"ar":"وَٱلشَّمۡسِ وَضُحَىٰهَا"},{"v":2,"ar":"وَٱلۡقَمَرِ إِذَا تَلَىٰهَا"},{"v":3,"ar":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا"},{"v":4,"ar":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰهَا"},{"v":5,"ar":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا"},{"v":6,"ar":"وَٱلۡأَرۡضِ وَمَا طَحَىٰهَا"},{"v":7,"ar":"وَنَفۡسࣲ وَمَا سَوَّىٰهَا"},{"v":8,"ar":"فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا"},{"v":9,"ar":"قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا"},{"v":10,"ar":"وَقَدۡ خَابَ مَن دَسَّىٰهَا"},{"v":11,"ar":"كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَآ"},{"v":12,"ar":"إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا"},{"v":13,"ar":"فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡيَٰهَا"},{"v":14,"ar":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىٰهَا"},{"v":15,"ar":"وَلَا يَخَافُ عُقۡبَٰهَا"}]}