{"n":1,"ayahs":[{"v":1,"ar":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ"},{"v":2,"ar":"ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ"},{"v":3,"ar":"ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ"},{"v":4,"ar":"مَٰلِكِ يَوۡمِ ٱلدِّينِ"},{"v":5,"ar":"إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ"},{"v":6,"ar":"ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ"},{"v":7,"ar":"صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ"}]}